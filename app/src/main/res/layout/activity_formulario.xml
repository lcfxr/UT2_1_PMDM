<?xml version="1.0" encoding="utf-8"?>
<!-- PANTALLA DE FORMULARIO -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_formulario"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- CODIGO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_codigo"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_codigo"
            android:inputType="text"
            android:maxLength="80"
            android:layout_marginBottom="16dp"/>

        <!-- RECORRIDO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_recorrido"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_recorrido"
            android:inputType="text"
            android:maxLength="80"
            android:layout_marginBottom="32dp"/>

        <!-- BOTONES -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_guardar"/>

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancelar"/>

    </LinearLayout>
</ScrollView>